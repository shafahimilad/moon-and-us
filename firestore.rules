rules_version = '2';
// Moon&Us data layout
//   users/{uid}                         pointer: { spaceId, role: 'her' | 'partner', name }
//   invites/{code}                      { spaceId, ownerUid, herName, createdAt, usedBy, usedAt } single use
//   feedback/{id}                       create-only help requests
//   spaces/{sid}                        { ownerUid, herName, partners: { uid: {name, joinedAt, invite} }, inviteCode }
//   spaces/{sid}/private/{doc}          owner only: settings (modes, profile, tags, reminders, pregnancy…)
//   spaces/{sid}/logs/{day}             owner only: every observation, notes, tags, temperatures
//   spaces/{sid}/shared/{doc}           readable by viewers: calendar projection (period days + engine settings)
//   spaces/{sid}/couple/status          her shared mood/needs (owner writes, viewers read)
//   spaces/{sid}/couple/kit             care-kit checklist (members)
//   spaces/{sid}/notes/{id}             messages between the two (members)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function spaceDoc(sid) { return get(/databases/$(database)/documents/spaces/$(sid)).data; }
    function isOwner(sid) { return signedIn() && spaceDoc(sid).ownerUid == request.auth.uid; }
    function isViewer(sid) { return signedIn() && request.auth.uid in spaceDoc(sid).partners; }
    function isMember(sid) { return isOwner(sid) || isViewer(sid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.usedBy == null
        && isOwner(request.resource.data.spaceId);
      // claimed once, by someone other than the owner
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.auth.uid != resource.data.ownerUid
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
    }

    match /spaces/{sid} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.partners);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.partners.size() == 0;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        // owner: anything except ownership
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid)
        ||
        // viewer leaving: removes only their own entry
        (request.auth.uid in resource.data.partners
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partners'])
          && request.resource.data.partners.diff(resource.data.partners).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.partners))
        ||
        // accepting an unused invite for this space, claimed in the same batch
        (request.auth.uid != resource.data.ownerUid
          && !(request.auth.uid in resource.data.partners)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partners'])
          && request.resource.data.partners.diff(resource.data.partners).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.partners[request.auth.uid].keys().hasOnly(['name', 'joinedAt', 'invite'])
          && get(invitePath(request.resource.data.partners[request.auth.uid].invite)).data.spaceId == sid
          && get(invitePath(request.resource.data.partners[request.auth.uid].invite)).data.usedBy == null
          && getAfter(invitePath(request.resource.data.partners[request.auth.uid].invite)).data.usedBy == request.auth.uid)
      );

      match /private/{doc} {
        allow read, write: if isOwner(sid);
      }
      match /logs/{day} {
        allow read, write: if isOwner(sid);
      }
      match /shared/{doc} {
        allow read: if isMember(sid);
        allow write: if isOwner(sid);
      }
      match /couple/status {
        allow read: if isMember(sid);
        allow write: if isOwner(sid);
      }
      match /couple/kit {
        allow read, write: if isMember(sid);
      }
      // Gifts: written by a member for the other (notes, photos, coupons, locked surprises).
      // She may only mark them opened / redeemed / loved; the author may delete.
      match /gifts/{giftId} {
        allow read: if isMember(sid);
        allow create: if isMember(sid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['note', 'photo', 'coupon', 'song', 'compliment']
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 800000))
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
        allow update: if isOwner(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt', 'redeemedAt', 'reaction']);
        allow delete: if isOwner(sid) || (isMember(sid) && resource.data.uid == request.auth.uid);
      }
      // Requests: she asks (one tap), viewers can only acknowledge.
      match /requests/{reqId} {
        allow read: if isMember(sid);
        allow create: if isOwner(sid) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open';
        allow update: if isOwner(sid)
          || (isViewer(sid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ackAt'])
            && request.resource.data.status in ['seen', 'onit', 'done']);
        allow delete: if isOwner(sid);
      }
      match /notes/{noteId} {
        allow read: if isMember(sid);
        allow create: if isMember(sid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow delete: if isOwner(sid) || (isMember(sid) && resource.data.uid == request.auth.uid);
      }
    }
  }
}
