rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function spaceData(sid) { return get(/databases/$(database)/documents/spaces/$(sid)).data; }
    function isOwner(sid) { return signedIn() && spaceData(sid).ownerUid == request.auth.uid; }
    function isMember(sid) {
      return signedIn() && (spaceData(sid).ownerUid == request.auth.uid || spaceData(sid).partnerUid == request.auth.uid);
    }

    // Each person's pointer to their space
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite links: anyone holding the code can read it (shows her name on the invite page)
    match /invites/{code} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isOwner(request.resource.data.spaceId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // One space per couple. She owns it; the partner can read it.
    match /spaces/{sid} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.partnerUid == null;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        // her: anything, but ownership can't change
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid)
        ||
        // partner: care kit, own name, or leaving
        (resource.data.partnerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['kit', 'partnerName', 'partnerUid', 'joinedWith', 'joinedAt'])
          && (request.resource.data.partnerUid == request.auth.uid || request.resource.data.partnerUid == null))
        ||
        // accepting an invite: only when nobody is connected yet and the invite belongs to this space
        (resource.data.partnerUid == null
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['partnerUid', 'partnerName', 'joinedWith', 'joinedAt'])
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.spaceId == sid)
      );

      match /logs/{day} {
        allow read: if isMember(sid);
        allow write: if isOwner(sid);
      }

      match /notes/{noteId} {
        allow read: if isMember(sid);
        allow create: if isMember(sid) && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(sid) || (isMember(sid) && resource.data.uid == request.auth.uid);
      }
    }
  }
}
